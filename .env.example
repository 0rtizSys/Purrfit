# --- Discord (required) ---
TOKEN= Here goes your bot token
CLIENT_ID= the bot ID
OWNER_ID= your main acc ID (only this user can run /sync_slash_guild)
GUILD_ID= your own server ID: developer commands are only registered there

# --- Database (required) ---
DATABASE_URL= Your Postgres/Supabase connection string
DATABASE_CA_CERT= (optional) Supabase SSL certificate (PEM, "\n" allowed) to verify the DB server
DATABASE_SSL= (optional) set to "disable" only for a local database without SSL (docker compose sets it)
DB_POOL_MAX= (optional) max DB connections, default 10

# --- Operations (optional) ---
LOG_LEVEL= debug | info | warn | error (default info)
ERROR_WEBHOOK_URL= Discord webhook URL that receives error alerts
DISABLE_JOBS= set to "true" to stop this instance from running crypto price ticks and bank interest
HEARTBEAT_LOG= set to "true" to also print the heartbeat (gateway ping, servers, users, RAM) to the log every 30 s; the local monitor (monitor/) turns it on by itself

# --- Links shown in /help, /support and /dashboard (optional) ---
DASHBOARD_URL= public address of the web dashboard (https://...), opened by /dashboard
SUPPORT_URL=
PRIVACY_URL=
TERMS_URL=

# --- docker compose only ---
POSTGRES_PASSWORD= password for the bundled Postgres container (default purrfit)

# --- Command list for the web dashboard (optional) ---
COMMANDS_MANIFEST_PATH= where `npm run export-commands` writes the command list (default data/commands.json)

# --- Market worker (optional) ---
MARKET_SNAPSHOT_PATH= where the market worker writes the price snapshot (default data/market.json)

TOKEN= Here goes your bot token
OWNER_ID= your main acc ID
CLIENT_ID= the bot ID
GUILD_ID= your testing guild ID where /sync_slash synces instantly 

DATABASE_URL= Your supabase URL
DATABASE_CA_CERT= (optional) Supabase SSL certificate (PEM, "\n" allowed) to verify the DB server
DB_POOL_MAX= (optional) max DB connections, default 10

DB_HOST= you DB host
DB_PORT= the DB port
DB_USER= your DB user
DB_PASSWORD= the DB password
DB_NAME= your DB name
{
  "name": "purrfit",
  "version": "2.1.0",
  "description": "Purrfit, a Discord economy bot",
  "license": "ISC",
  "author": "me",
  "main": "dist/bot/index.js",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/scripts/migrate.js && node dist/bot/index.js",
    "compile": "npx tsc && node dist/bot/index.js",
    "init": "node dist/bot/index.js",
    "migrate": "node dist/scripts/migrate.js",
    "deploy-commands": "node dist/scripts/deploy_commands.js",
    "test": "jest",
    "test:integration": "jest src/bot/tests/integration",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "discord.js": "^14.26.3",
    "dotenv": "^17.4.2",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=20"
  }
}
